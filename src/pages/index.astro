---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { REQUIRED_CHECKS, isChecked, isVerified, isVisible } from '../lib/visibility';

const articles = { m: 'der', f: 'die', n: 'das', pl: 'die' } as const;
const nouns = (
  await getCollection('nouns', ({ data }) =>
    isVisible(data, import.meta.env.DEV, REQUIRED_CHECKS.noun),
  )
).sort((a, b) => a.data.noun.localeCompare(b.data.noun, 'de'));

const pluralNote = (n: (typeof nouns)[number]['data']) =>
  n.pluralOnly ? '(only plural)' : n.plural ? `(Pl. die ${n.plural})` : '(no plural)';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SchwierigeDeutsch</title>
  </head>
  <body>
    <h1>SchwierigeDeutsch</h1>
    <p>Sample A1 nouns (placeholder page).</p>
    <ul class="noun-list">
      {
        nouns.map(({ data: n }) => (
          <li>
            <span class={`article gender-${n.gender}`}>{articles[n.gender]}</span>
            <span lang="de">{n.noun}</span>
            <span lang="de">{pluralNote(n)}</span>
            <span>– {n.translation.en}</span>
            {!isVerified(n) && <span class="badge-unreviewed">unreviewed</span>}
            {isVerified(n) && !isChecked(n, 'translation') && (
              <span class="badge-unreviewed">translation unchecked</span>
            )}
          </li>
        ))
      }
    </ul>
  </body>
</html>
