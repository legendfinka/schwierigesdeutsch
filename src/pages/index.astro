---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GenderTag from '../components/GenderTag.astro';
import { GENDER_LABEL, type Gender } from '../lib/gender';
import { levelsOf } from '../lib/levels';
import { url } from '../lib/url';
import { REQUIRED_CHECKS, isVisible } from '../lib/visibility';

const nouns = await getCollection('nouns', ({ data }) =>
  isVisible(data, import.meta.env.DEV, REQUIRED_CHECKS.noun),
);
const levels = levelsOf(nouns.map((e) => e.data));
const range = levels.length > 1 ? `${levels[0]} to ${levels[levels.length - 1]}` : (levels[0] ?? '');

const genders: Gender[] = ['m', 'f', 'n', 'pl'];

const sections = [
  {
    title: 'Nouns',
    href: url('/nouns/'),
    text: `${nouns.length} nouns from ${range}. Practice the article and the plural.`,
  },
  {
    title: 'Cases',
    href: url('/cases/'),
    text: 'Why the article changes. Short rules and quizzes.',
  },
  { title: 'Sentences', text: 'Tap a sentence to see its verb, subject and objects.' },
  { title: 'Stories', text: 'Short A1 and A2 stories to read and listen to.' },
  { title: 'Grammar', text: 'Short rules in plain English.' },
];
---

<BaseLayout>
  <div class="home">
    <section class="hero">
      <h1>See how German is built</h1>
      <p class="hero__lead">
        You can know every word and still not see who does what. Here you learn the structure: the
        article, the case, the verb and the subject.
      </p>
      <p class="hero__buttons">
        <a class="btn btn--primary" href={url('/nouns/practice/')}>Practice nouns</a>
        <a class="btn" href={url('/nouns/')}>Browse by level</a>
      </p>

      <div class="hero__colors">
        <p class="hero__label">Every noun shows its article in a color. The article is always written too.</p>
        <ul class="legend">
          {
            genders.map((g) => (
              <li>
                <GenderTag gender={g} /> <span aria-hidden="true">{GENDER_LABEL[g]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section aria-labelledby="start">
      <h2 id="start">What's here</h2>
      <ul class="cards">
        {
          sections.map((s) => (
            <li>
              {s.href ? (
                <a class="card section-card" href={s.href}>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </a>
              ) : (
                <div class="card section-card section-card--soon">
                  <h3>
                    {s.title} <span class="badge">soon</span>
                  </h3>
                  <p>{s.text}</p>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: var(--space-6);
  }

  .hero {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: var(--space-5);
  }

  .hero h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.1rem);
    margin-bottom: var(--space-2);
  }

  .hero__lead {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .hero__colors {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
  }

  .hero__label {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.95rem;
  }

  h2 {
    font-size: 1.2rem;
    margin-bottom: var(--space-3);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .section-card {
    height: 100%;
    padding: var(--space-4);
  }

  .section-card h3 {
    font-size: 1.05rem;
    margin-bottom: var(--space-1);
  }

  .section-card p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .section-card--soon {
    background: var(--surface-sunk);
    box-shadow: none;
  }
</style>
