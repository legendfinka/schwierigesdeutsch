---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NounsNav from '../../components/NounsNav.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { visibleNouns } from '../../lib/load-nouns';
import { groupByLevel } from '../../lib/levels';
import { groupByTopic } from '../../lib/topics';
import { url } from '../../lib/url';

const nouns = await visibleNouns();
const levels = groupByLevel(nouns).map(({ level, items }) => ({
  level,
  items,
  topics: groupByTopic(items),
}));
---

<BaseLayout title="Nouns" description="German nouns by level and topic, with article and plural.">
  <h1>Nouns</h1>
  <NounsNav current="overview" />

  <p class="lead">
    Learn every noun together with its article: the article tells you the gender, and the
    gender decides how the sentence around it changes.
  </p>

  <section class="card overview" aria-labelledby="your-progress">
    <h2 id="your-progress">Your progress</h2>
    <p class="muted overview__count">{nouns.length} nouns</p>
    <ProgressBar ids={nouns.map((n) => n.id)} showDue large />
    <a class="btn btn--primary overview__cta" href={url('/nouns/practice/')}>Practice all</a>
  </section>

  {
    levels.length > 1 && (
      <nav class="levels" aria-label="Jump to a level">
        <ul>
          {levels.map(({ level, items }) => (
            <li>
              <a href={`#${level.toLowerCase()}`}>
                {level} <span class="levels__count">{items.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    levels.map(({ level, items, topics }) => (
      <section class="level" aria-labelledby={level.toLowerCase()}>
        <h2 id={level.toLowerCase()}>
          {level} <span class="muted level__count">{items.length} nouns</span>
        </h2>
        <ProgressBar ids={items.map((n) => n.id)} showDue />
        <a class="btn level__practice" href={url(`/nouns/practice/?level=${level}`)}>
          Practice {level}
        </a>

        <ul class="card-grid">
          {topics.map(({ topic, items: inTopic }) => (
            <li class="card topic-card">
              <h3>
                <a href={url(`/nouns/${topic.id}/#${level.toLowerCase()}`)}>{topic.label}</a>
              </h3>
              <p class="muted">{inTopic.length} nouns</p>
              <ProgressBar ids={inTopic.map((n) => n.id)} />
              <a
                class="btn topic-card__practice"
                href={url(`/nouns/practice/?topic=${topic.id}&level=${level}`)}
              >
                Practice
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .overview {
    margin-bottom: var(--space-6);
  }

  .overview h2 {
    margin-top: 0;
  }

  .overview__count {
    margin-bottom: var(--space-2);
  }

  .overview__cta,
  .level__practice,
  .topic-card__practice {
    margin-top: var(--space-3);
  }

  .levels ul {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .levels a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }

  .levels a:hover {
    border-color: var(--accent);
  }

  .levels__count {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .level {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    scroll-margin-top: var(--space-4);
  }

  .level h2 {
    margin: 0;
  }

  .level__count {
    font-size: 1rem;
    font-weight: 400;
  }

  .level__practice {
    margin-bottom: var(--space-5);
  }

  .topic-card {
    display: flex;
    flex-direction: column;
  }

  .topic-card h3 {
    margin: 0 0 var(--space-1);
  }

  .topic-card p {
    margin: 0;
  }

  /* Pins the button to the bottom so cards line up. */
  .topic-card__practice {
    margin-top: auto;
    align-self: flex-start;
  }

  .topic-card :global(.stats) {
    margin-bottom: var(--space-3);
  }
</style>
